using "../../platforms/cortex_m0_mram_tracked.repl"

counterReg: Python.PythonPeripheral @ sysbus 0x40010000
    size: 4
    initable: true
    script: '''
if request.IsInit:
    reset_us = int(self.GetMachine().LocalTimeSource.ElapsedVirtualTime.TotalMicroseconds)
elif request.IsRead:
    request.Value = (int(self.GetMachine().LocalTimeSource.ElapsedVirtualTime.TotalMicroseconds) - reset_us) & 0xffffffff
'''

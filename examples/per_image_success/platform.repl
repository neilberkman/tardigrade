cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0+"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

boot: Memory.MappedMemory @ sysbus 0x0
    size: 0x1000

images: Memory.MappedMemory @ sysbus 0x10100000
    size: 0x3000

tracker: Miscellaneous.MappedMRAMTracker @ sysbus 0x40000000
    BackingMemory: images
    FlashBaseAddress: 0x10100000
    FlashSize: 0x3000
    ProgramUnitSize: 4
    EraseFill: 0xFF
    PageSize: 0x100
    EraseAddressRegisterOffset: 0

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x2000

  "upstream_issues": {
    "#121749": {
      "url": "https://github.com/zephyrproject-rtos/zephyr/issues/121749",
      "references": [
        "#121748"
      ],
      "summary": "Power cut during fcb_sector_hdr_init() after fd_magic is written leaves fd_ver and fd_id erased (fd_id = 0xFFFF); fcb_sector_hdr_read() validates only fd_magic, FCB_ID_GT treats 0xFFFF (-1) as f_oldest, fcb_free_sector_cnt() becomes 0 (-ENOSPC in raw FCB), and settings_fcb_src() erases f_active (the active data sector) instead of the scratch sector."
    },
    "#122446": {
      "url": "https://github.com/zephyrproject-rtos/zephyr/issues/122446",
      "summary": "Power cut during entry payload write before fcb_append_finish() leaves the trailing CRC-8 byte erased (0xFF); when crc8_ccitt(0xFF, length_header || partial_payload || remaining_0xFF_bytes) == 0xFF, fcb_elem_crc8() accepts the torn uncommitted entry as valid."
    },
    "#121748": {
      "url": "https://github.com/zephyrproject-rtos/zephyr/issues/121748",
      "summary": "Referenced by #121749: power cut after the first byte of a 2-byte entry length header (entries >= 128 bytes) causes fcb_get_len() to decode an oversized length and fcb_init() to fail permanently with -EIO. Not exercised by these 24-byte/32-byte record profiles."
    }
  },
  "api_differences_at_head": [
    "No application source changes were required between 36940db938a8 (v3.7.0) and 06b50e7c66d2 (v4.5.99 head); both fcb_raw/src/main.c and settings_fcb/src/main.c compile unchanged.",
    "In include/zephyr/fs/fcb.h, struct fcb field f_sector_cnt widened from uint8_t to uint16_t.",
    "In subsys/fs/fcb/fcb.c, commit f15889378791 (issue #111886) changed fcb_sector_hdr_init() to write a 16-byte WRITE_ALIGNMENT_BUFFER_SIZE union padded with f_erase_value (0xFF) instead of an 8-byte struct fcb_disk_area, adding two 4-byte 0xFFFFFFFF padding writes (+0x008 and +0x00C) per sector header initialization."
  ],

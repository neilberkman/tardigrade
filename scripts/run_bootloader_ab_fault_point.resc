# Generic A/B bootloader OTA fault campaign.
#
# The Robot suite compiles the peripheral models once.  Batch mode then runs
# the clean control followed by every requested fault point in this same
# Renode process; the Python runner recreates the machine between points so
# NVM, SRAM, CPU, and peripheral state cannot leak across iterations.

$repo_root?=""
$fault_at?=0
$fault_points_csv?=""
$total_writes?=0
$result_file?="bootloader_ab_fault_result.json"
$include_metadata_faults?=false
$evaluation_mode?="execute"
$boot_mode?="direct"
$write_granularity?=0
$slot_a_base?=0
$slot_a_image_file?=""
$slot_b_base?=0
$slot_b_image_file?=""
$slot_size?=0
$ota_header_size?=0
$meta_base_0?=0
$meta_base_1?=0
$meta_size?=0
$bootloader_entry?=0
$nvm_ctrl_path?="sysbus.nvm_ctrl"
$nvm_base?=0
$nvm_size?=0
$run_duration?=""
$trace_execution?=false
$trace_file?=""
$platform_repl?=""
$firmware_elf?=""
$bootloader_elf?=""
$boot_meta_bin?=""
$boot_meta_load_addr?=0
$expected_control_slot?=""
$boot_marker_addr?=0
$boot_marker_value?=0
$boot_marker_other_value?=0
$boot_observation_timeout_s?=""
$boot_poll_interval_s?=""
$boot_wall_timeout_s?=""
$pre_boot_writes?=""

python """
import os as _os
_repo_root = str(monitor.GetVariable('repo_root')).strip()
if not _repo_root:
    raise Exception('repo_root is required')
_runner = _os.path.join(_repo_root, 'scripts', 'run_bootloader_ab_fault_batch.py')
_runner_globals = globals()
_runner_globals['__file__'] = _runner
_runner_globals.setdefault('__name__', '__main__')
try:
    execfile
except NameError:
    with open(_runner, 'rb') as _f:
        _source = _f.read()
    exec(compile(_source, _runner, 'exec'), _runner_globals, _runner_globals)
else:
    execfile(_runner, _runner_globals)
"""

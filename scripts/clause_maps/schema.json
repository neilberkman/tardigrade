{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mapping_version", "clauses"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "mapping_version": {"type": "integer", "minimum": 1},
    "clauses": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["regulation", "paragraph", "citation", "paraphrase", "campaigns", "fault_scope", "criteria", "limit"],
        "properties": {
          "regulation": {"$ref": "#/definitions/text"},
          "paragraph": {"$ref": "#/definitions/text"},
          "citation": {"type": "string", "pattern": "^https://[A-Za-z0-9.-]+/[^\\s<>]+$"},
          "paraphrase": {"$ref": "#/definitions/text"},
          "limit": {"$ref": "#/definitions/text"},
          "campaigns": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["runtime_sweep", "multi_fault_runtime_sweep"]}
          },
          "fault_scope": {"enum": ["interruption", "any_injection"]},
          "criteria": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["boot_handoff", "running_image", "image_digest", "verification_probe"]}
          }
        }
      }
    }
  },
  "definitions": {
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"}
  }
}

$security_anti_rollback?="false"
$progress_stall_timeout_s?="20"
$expect_control_outcome?=""
$no_boot_zero_write_slices?="10"
$no_boot_min_emulated_s?="0.1"
$sweep_diff_lookahead?="2147483647"
$hash_bypass_symbols?=""
$rc_injection_symbols?=""
$rc_injection_return_value?="4294967291"
$rc_injection_return_register?="0"
$rc_injection_require_applied?="true"
$postmortem_dump_no_boot?="true"
$postmortem_dump_header_bytes?="4096"
$resume_trace_no_boot?="true"
$resume_trace_max_ops?="1024"

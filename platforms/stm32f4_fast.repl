// Fast STM32F4 platform for execute-mode testing.
//
// Uses MappedMemory for flash at both 0x00000000 and 0x08000000
// (STM32F4 dual-mapped flash). CPU reads/writes go directly through
// MappedMemory (fast tlib pointer access). Write tracking is done
// through the STM32F4FastFlash peripheral counting PG transitions.
//
// RCC is a separate lightweight stub — no callback overhead on
// clock register polling.

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

flash: Memory.MappedMemory @ { sysbus 0x00000000; sysbus 0x08000000 }
    size: 0x200000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x40000

rcc: Miscellaneous.STM32F4RCCStub @ sysbus 0x40023800

faultFlash: Miscellaneous.STM32F4FastFlash @ sysbus 0x40023C00
    Flash: flash
    FlashBaseAddress: 0x08000000
    FlashSize: 0x200000
    PageSize: 0x20000
    EraseFill: 0xFF

uart1: Miscellaneous.STM32DummyUSART @ sysbus 0x40011000
uart2: Miscellaneous.STM32DummyUSART @ sysbus 0x40004400
uart3: Miscellaneous.STM32DummyUSART @ sysbus 0x40004800
uart6: Miscellaneous.STM32DummyUSART @ sysbus 0x40011400

gpioA: Memory.MappedMemory @ sysbus 0x40020000
    size: 0x400
gpioB: Memory.MappedMemory @ sysbus 0x40020400
    size: 0x400
gpioC: Memory.MappedMemory @ sysbus 0x40020800
    size: 0x400
gpioD: Memory.MappedMemory @ sysbus 0x40020C00
    size: 0x400
gpioE: Memory.MappedMemory @ sysbus 0x40021000
    size: 0x400
gpioF: Memory.MappedMemory @ sysbus 0x40021400
    size: 0x400
gpioG: Memory.MappedMemory @ sysbus 0x40021800
    size: 0x400
gpioH: Memory.MappedMemory @ sysbus 0x40021C00
    size: 0x400
gpioI: Memory.MappedMemory @ sysbus 0x40022000
    size: 0x400
pwr: Memory.MappedMemory @ sysbus 0x40007000
    size: 0x400
dbgmcu: Memory.MappedMemory @ sysbus 0xE0042000
    size: 0x400

sysbus:
    init:
        Tag <0x00000000 0x200000> "FLASH_LO"
        Tag <0x08000000 0x200000> "FLASH_HI"
        Tag <0x20000000 0x40000> "SRAM"
        Tag <0x40007000 0x400> "PWR"
        Tag <0x40020000 0x2400> "GPIO"
        Tag <0xE0042000 0x400> "DBGMCU"

// Hybrid Cortex-M0+ platform with fast MappedMemory boot ROM and
// NVMemory + NVMemoryController data storage for execute-mode erase/program sweeps.

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0+"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

boot: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x2000

boot_alias: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x2000

nvm: Memory.NVMemory @ sysbus 0x10100000
    Size: 0x4000
    WordSize: 4
    EnforceWordWriteSemantics: true
    WriteLatencyMicros: 0
    EraseFill: 0xFF
    ProgramAddressBase: 0x10100000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x2000

nvm_ctrl: NVMemoryController @ sysbus 0x40001000
    Nvm: nvm
    NvmBaseAddress: 0x10100000
    FullMode: true

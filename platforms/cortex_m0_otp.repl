// Cortex-M0+ platform with NVMemory (main storage) and OTP eFuse region.
//
// The OTP region models a generic eFuse array used for anti-rollback
// counters, security configuration bits, and device identity.
// Main firmware storage uses NVMemory as in cortex_m0_nvm.repl.

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0+"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

nvm: Memory.NVMemory @ sysbus 0x10000000
    Size: 0x80000
    WordSize: 8
    EnforceWordWriteSemantics: true
    WriteLatencyMicros: 0

nvm_boot_alias: Memory.NVMemory @ sysbus 0x00000000
    AliasTarget: nvm

nvm_read_alias: Memory.NVMemory @ sysbus 0x10080000
    AliasTarget: nvm
    ReadOnly: true

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

nvm_ctrl: NVMemoryController @ sysbus 0x40001000
    Nvm: nvm
    FullMode: true

// OTP eFuse region: 256 bytes (2048 fuse bits) at 0x40002000.
// Word-granularity (32-bit) blow operations.
otp: Memory.OTPMemory @ sysbus 0x40002000
    Size: 0x100
    WriteGranularity: 32

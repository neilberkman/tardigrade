cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m0+"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    -> cpu@0

boot: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x1000

mramStorage: Memory.MappedMemory @ sysbus 0x10100000
    size: 0x3000

mramTracker: Miscellaneous.MappedMRAMTracker @ sysbus 0x40000000
    BackingMemory: mramStorage
    FlashBaseAddress: 0x10100000
    FlashSize: 0x3000
    ProgramUnitSize: 16
    EraseFill: 0x00

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x2000
